# Copy to .env and fill in. .env is gitignored.

# Environment
ENVIRONMENT=development

# Frontend serving (docker mounts highperformer/dist into /app/static)
STATIC_DIR=/app/static
CORS_ORIGINS=http://localhost:8001

# Keycloak OIDC — ask the team for KEYCLOAK_CLIENT_SECRET
KEYCLOAK_URL=https://keycloak.cbioportal.org/auth
KEYCLOAK_REALM=cell-explorer
KEYCLOAK_CLIENT_ID=cell-explorer-app
KEYCLOAK_CLIENT_SECRET=

# Session cookie lifetimes (seconds). Tune REFRESH_COOKIE_MAX_AGE to match the
# realm's ssoSessionMaxLifespan (currently 24h = 86400). Setting it higher than
# Keycloak allows just causes refresh to fail before the cookie expires.
# ACCESS_COOKIE_MAX_AGE=300       # 5 min — matches Keycloak accessTokenLifespan
# REFRESH_COOKIE_MAX_AGE=86400    # 24h

# Datasource credential signing (./dev-keys is mounted at /keys in container)
DATASOURCE_LOCAL_PRIVATE_KEY_FILE=/keys/private.pem

# Admin API
ADMIN_API_KEY=dev-admin-key-123

# CLI integration — generate CLI_STATE_SECRET with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
CELL_EXPLORER_API_URL=http://localhost:8001
CLI_STATE_SECRET=

# LLM — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Langfuse observability (optional). Unset = no tracing. Per-dataset is_public
# flag gates whether content (user text, view state, tool args) is sent.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACE_ENABLED=true              # kill switch — false disables without rotating keys
# LANGFUSE_TRACING_ENVIRONMENT=local       # local|development|production — overrides ENVIRONMENT for Langfuse's UI environment filter

# Set to false to disable Plan 2 view-control tools (set_viewport,
# set_summary_context, set_gene_label_column, set_render_controls).
# CHAT_EXPERIMENTAL_VIEW_TOOLS=true

# Optional Keycloak role gate for chat. Unset = any authed user can chat.
# CHAT_REQUIRED_ROLE=cell-explorer-chat

# Optional: trace every zarr HTTP request to a JSONL file (for perf debugging)
# ZARR_ACCESS_TRACE=1
# ZARR_ACCESS_TRACE_FILE=trace.jsonl

# Optional: override the Origin header sent on server-side zarr fetches.
# Defaults to https://cell-explorer.cbioportal.org. Only set this if hitting
# a bucket with AllowedOrigins restricted to a specific value (since S3 with
# AllowedOrigins: ['*'] echoes Access-Control-Allow-Origin: * regardless).
# ZARR_ACCESS_ORIGIN=https://cell-explorer.cbioportal.org
